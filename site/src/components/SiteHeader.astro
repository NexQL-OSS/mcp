---
import { REPO_URL, SITE_VERSION } from "../data/site";

interface Props {
  current?: "tour" | "docs" | "install" | "story" | "setup";
}
const { current } = Astro.props;
const links = [
  { id: "tour", href: "/", label: "Tour" },
  { id: "docs", href: "/docs", label: "Docs" },
  { id: "install", href: "/install", label: "Claude Desktop" },
  { id: "story", href: "/story", label: "See a session" },
  { id: "setup", href: "/setup", label: "Agent prompts" },
] as const;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="NexQL MCP home">
      <span class="mark" aria-hidden="true"></span>
      <span class="word">NexQL</span>
      <span class="chip">MCP</span>
    </a>
    <div class="theme-switch" role="radiogroup" aria-label="Color theme">
      <button type="button" role="radio" data-choice="system" aria-checked="true" aria-label="System">
        <span class="full">System</span><span class="short" aria-hidden="true">Auto</span>
      </button>
      <button type="button" role="radio" data-choice="dark" aria-checked="false" tabindex="-1" aria-label="Dark">Dark</button>
      <button type="button" role="radio" data-choice="light" aria-checked="false" tabindex="-1" aria-label="Light">Light</button>
    </div>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" hidden>
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="menu-label">Menu</span>
    </button>
    <nav id="site-nav" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} class:list={["nav-link", { secondary: l.id === "story" || l.id === "setup" }]} aria-current={current === l.id ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
      <a class="nav-link gh" href={REPO_URL}>GitHub <span class="ver">v{SITE_VERSION}</span></a>
    </nav>
  </div>
  <div class="ribbon"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg-deep) 84%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .ribbon {
    height: 2px;
    border-radius: 0;
    opacity: 0.85;
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--fg);
    font-weight: 700;
    font-size: 17px;
    text-decoration: none;
    flex: none;
  }
  .mark {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--nex-grad);
    box-shadow: var(--mark-glow);
  }
  .chip {
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 6px;
    padding: 4px 6px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    margin-left: auto;
    order: 1;
  }
  .theme-switch {
    order: 2;
    display: inline-flex;
    align-items: center;
    flex: none;
    padding: 3px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--panel);
  }
  .theme-switch button {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: 600 12.5px/1 var(--font-body);
    padding: 7px 10px;
    border-radius: 999px;
    cursor: pointer;
    min-height: 32px;
  }
  .theme-switch .short {
    display: none;
  }
  .theme-switch button[aria-checked="true"] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .theme-switch button:hover {
    color: var(--fg);
  }
  .theme-switch button[aria-checked="true"]:hover {
    background: var(--accent-hover);
    color: var(--accent-ink);
  }
  .nav-link {
    color: var(--muted);
    font-size: 14.5px;
    padding: 8px 10px;
    border-radius: 8px;
    white-space: nowrap;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--fg);
    text-decoration: none;
    background: var(--panel);
  }
  .ver {
    font: 500 11px/1 var(--font-mono);
    color: var(--faint);
    margin-left: 4px;
  }
  .menu-btn {
    display: none;
    align-items: center;
    order: 3;
    gap: 9px;
    margin-left: 8px;
    padding: 8px 12px;
    border: 1px solid var(--line-2);
    border-radius: 9px;
    background: var(--panel);
    color: var(--fg);
    font: 500 14px/1 var(--font-body);
    cursor: pointer;
  }
  .menu-btn:hover {
    border-color: var(--accent);
  }
  .bars {
    position: relative;
    width: 16px;
    height: 12px;
  }
  .bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.2s, opacity 0.2s, top 0.2s;
  }
  .bars span:nth-child(1) {
    top: 0;
  }
  .bars span:nth-child(2) {
    top: 5px;
  }
  .bars span:nth-child(3) {
    top: 10px;
  }
  .menu-btn[aria-expanded="true"] .bars span:nth-child(1) {
    top: 5px;
    transform: rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] .bars span:nth-child(2) {
    opacity: 0;
  }
  .menu-btn[aria-expanded="true"] .bars span:nth-child(3) {
    top: 5px;
    transform: rotate(-45deg);
  }

  /* Narrow screens: every link moves into a menu under the header. Without JS
     the button stays hidden and the short inline nav below is used instead. */
  @media (max-width: 860px) {
    .site-header.has-menu .menu-btn {
      display: inline-flex;
    }
    .site-header.has-menu nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 10px 16px 18px;
      background: var(--bg-deep);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--menu-shadow);
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
    }
    .site-header.has-menu.open nav {
      display: flex;
    }
    .site-header.has-menu .nav-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 13px 14px;
      font-size: 16px;
    }
    .site-header.has-menu .gh {
      margin-top: 6px;
      border-top: 1px solid var(--line);
      border-radius: 0 0 8px 8px;
      padding-top: 16px;
    }
    .site-header:not(.has-menu) .secondary,
    .site-header:not(.has-menu) .ver {
      display: none;
    }
  }
  @media (max-width: 860px) {
    nav {
      margin-left: 0;
    }
    .theme-switch {
      margin-left: auto;
    }
  }
  @media (max-width: 640px) {
    .theme-switch .full {
      display: none;
    }
    .theme-switch .short {
      display: inline;
    }
    .theme-switch button {
      padding: 7px 8px;
    }
  }
  @media (max-width: 520px) {
    .word {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .site-header:not(.has-menu) .nav-link {
      padding: 8px 7px;
      font-size: 14px;
    }
    .site-header:not(.has-menu) .word,
    .site-header:not(.has-menu) .gh {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const btn = header?.querySelector<HTMLButtonElement>(".menu-btn");
  if (header && btn) {
    const nav = header.querySelector<HTMLElement>("nav")!;
    header.classList.add("has-menu");
    btn.hidden = false;
    const set = (open: boolean) => {
      header.classList.toggle("open", open);
      btn.setAttribute("aria-expanded", String(open));
    };
    btn.addEventListener("click", () => set(!header.classList.contains("open")));
    nav.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) set(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && header.classList.contains("open")) {
        set(false);
        btn.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (!header.contains(e.target as Node)) set(false);
    });
    matchMedia("(min-width: 861px)").addEventListener("change", (e) => e.matches && set(false));
  }
</script>

<script is:inline>
  (function () {
    var group = document.querySelector(".theme-switch");
    if (!group) return;
    var buttons = [].slice.call(group.querySelectorAll("[data-choice]"));
    function current() {
      return document.documentElement.getAttribute("data-theme-choice") || "system";
    }
    function sync(focus) {
      var choice = current();
      buttons.forEach(function (b) {
        var on = b.getAttribute("data-choice") === choice;
        b.setAttribute("aria-checked", on ? "true" : "false");
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
    }
    function setTheme(choice, focus) {
      var apply = window.__nexqlSetTheme;
      if (typeof apply === "function") apply(choice);
      sync(focus);
    }
    buttons.forEach(function (b, i) {
      b.addEventListener("click", function () {
        setTheme(b.getAttribute("data-choice"), false);
      });
      b.addEventListener("keydown", function (e) {
        var step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        var next = buttons[(i + step + buttons.length) % buttons.length];
        setTheme(next.getAttribute("data-choice"), true);
      });
    });
    sync(false);
  })();
</script>
