---
/**
 * A replayed conversation as a plain page: one section per question, read by
 * scrolling. A sticky rail (a progress bar on narrow screens) tracks where you
 * are, like the tour's route; scenes fade in and their charts draw as they
 * arrive. Tool names link to their docs pages.
 */
import SceneMark from "./SceneMark.astro";
import { TOOLS, toolHref } from "../data/docs";
import type { Replay } from "../data/scenes";

interface Props {
  replay: Replay;
  /** What the rail calls each section, e.g. "Question" or "Step". */
  unit: string;
}

const { replay, unit } = Astro.props;
const { scenes, agentLabel, stepsLabel, roleHue } = replay;
const pad = (n: number) => String(n).padStart(2, "0");
const toolOf = (name: string) => TOOLS.find((t) => t.name === name);
---

<script is:inline>
  document.documentElement.classList.add("js");
</script>

<div class="mbar">
  <div class="mbar-fill"></div>
  <span class="mbar-label">{unit} 01 of {pad(scenes.length)} · {scenes[0].label}</span>
</div>

<div class="flow wrap">
  <nav class="rail" aria-label={`${unit}s`}>
    <div class="track"><div class="track-fill"></div></div>
    <ol>
      {
        scenes.map((s, i) => (
          <li>
            <a href={`#q${i + 1}`} data-scene={i}>
              <span class="dot" />
              <span class="rail-text">
                <span class="rail-no">
                  {s.where ? `${s.chapter} · ${s.where}` : s.chapter}
                </span>
                <span class="rail-label">{s.label}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="scenes">
    {
      scenes.map((s, i) => {
        const hue = roleHue(s.role);
        return (
          <section class="scene" id={`q${i + 1}`} style={`--hue:${hue}`}>
            <header class="scene-head">
              <span class="no">{pad(i + 1)}</span>
              <span class="chap">
                {s.chapter}
                {s.where && <span class="when"> · {s.where}</span>}
              </span>
            </header>
            <h2>{s.label}</h2>

            <div class="ask">
              <p class="who">{s.role === "YOU" ? "You ask" : s.role.toLowerCase()}</p>
              <p class="bubble">{s.prompt}</p>
            </div>

            <div class="answer">
              <p class="agent">
                <span class="spark" aria-hidden="true" />
                {agentLabel}
              </p>

              <div class="steps-box">
                <p class="steps-label">{stepsLabel}</p>
                <ol class="steps">
                  {s.steps.map(([what, did, note]) => {
                    const tool = toolOf(what);
                    return (
                      <li style={tool ? `--c:${tool.line.color}` : undefined}>
                        {tool ? (
                          <a class="tool" href={toolHref(tool.name)}>
                            {tool.name}
                          </a>
                        ) : (
                          <span class="num">{what}</span>
                        )}
                        <span class="did">
                          {did}
                          {note !== "—" && <span class="note">{note}</span>}
                        </span>
                      </li>
                    );
                  })}
                </ol>
              </div>

              <p class="insight">{s.insight}</p>

              {s.figures.length > 0 && (
                <dl class="figures">
                  {s.figures.map(([v, l], k) => (
                    <div class={k === 0 ? "lead" : undefined}>
                      <dt>{l.toLowerCase()}</dt>
                      <dd>{v}</dd>
                    </div>
                  ))}
                </dl>
              )}

              <SceneMark mark={s.mark} />
            </div>
          </section>
        );
      })
    }
  </div>
</div>

<style>
  /* ---------- Mobile progress ---------- */
  .mbar {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: color-mix(in srgb, var(--bg-deep) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    padding: 9px 16px 10px;
    font: 500 12.5px/1.2 var(--font-mono);
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mbar-fill {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 0;
    background: var(--nex-grad);
    transition: width 0.2s;
  }
  @media (min-width: 960px) {
    .mbar {
      display: none;
    }
  }

  /* ---------- Layout ---------- */
  .flow {
    display: grid;
    gap: 40px;
    padding-top: 32px;
  }
  @media (min-width: 960px) {
    .flow {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 56px;
      padding-top: 16px;
    }
  }
  .rail {
    display: none;
  }
  @media (min-width: 960px) {
    .rail {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 40px);
      align-self: start;
    }
  }
  .rail ol {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .track {
    position: absolute;
    left: 8px;
    top: 14px;
    width: 3px;
    height: calc(var(--rail-h, 300px) - 28px);
    background: var(--line);
    border-radius: 3px;
    overflow: hidden;
  }
  .track-fill {
    width: 100%;
    height: 0;
    background: var(--nex-grad-v);
    background-size: 100% var(--rail-h, 300px);
    transition: height 0.15s linear;
  }
  .rail a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 8px 0;
    color: var(--faint);
    position: relative;
    z-index: 1;
  }
  .rail a:hover {
    text-decoration: none;
    color: var(--fg);
  }
  .dot {
    width: 19px;
    height: 19px;
    flex: none;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--line-2);
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }
  .rail a.done .dot {
    border-color: var(--accent);
    background: var(--accent);
  }
  .rail a.active {
    color: var(--fg);
  }
  .rail a.active .dot {
    border-color: var(--accent);
    background: var(--bg);
    box-shadow: 0 0 0 5px rgba(224, 164, 204, 0.16), 0 0 18px rgba(224, 164, 204, 0.5);
  }
  .rail-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .rail-no {
    font: 500 11px/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .rail-label {
    font-size: 14.5px;
    font-weight: 500;
  }

  /* ---------- Scenes ---------- */
  .scenes {
    min-width: 0;
    max-width: 800px;
  }
  .scene {
    padding: 8px 0 72px;
    margin-bottom: 72px;
    border-bottom: 1px solid var(--line);
  }
  .scene:last-child {
    margin-bottom: 0;
  }
  .scene-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .no {
    font: 500 13px/1 var(--font-mono);
    color: var(--accent-ink);
    background: var(--accent);
    border-radius: 7px;
    padding: 6px 8px;
  }
  .chap {
    font: 500 12.5px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .when {
    color: var(--faint);
  }
  h2 {
    margin-top: 14px;
    font-size: clamp(26px, 3.4vw, 34px);
  }

  /* The question, on the right like a chat message. */
  .ask {
    margin: 26px 0 0 auto;
    max-width: min(560px, 92%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .who {
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hue);
    margin-bottom: 8px;
  }
  .bubble {
    padding: 13px 17px;
    border-radius: 16px 16px 4px 16px;
    background: color-mix(in srgb, var(--hue) 14%, var(--panel-2));
    border: 1px solid color-mix(in srgb, var(--hue) 38%, transparent);
    font-size: 18px;
    line-height: 1.5;
  }

  /* The answer. */
  .answer {
    margin-top: 26px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
  }
  .agent {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .spark {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: var(--nex-grad);
  }
  .steps-box {
    border-left: 2px solid var(--line-2);
    padding: 2px 0 2px 18px;
  }
  .steps-label {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 12px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 12px;
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    /* Tool names are long; put what it did underneath. */
    .steps li:has(.tool) {
      grid-template-columns: 1fr;
      gap: 4px;
      justify-items: start;
    }
  }
  .tool {
    font: 500 13.5px/1.4 var(--font-mono);
    color: var(--fg);
    padding: 3px 9px 3px 8px;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
    border-left: 3px solid var(--c);
    background: color-mix(in srgb, var(--c) 10%, transparent);
  }
  .tool:hover {
    text-decoration: none;
    border-color: var(--c);
  }
  .num {
    font: 500 12.5px/1 var(--font-mono);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: inline-grid;
    place-items: center;
    align-self: start;
  }
  .note {
    margin-left: 10px;
    font: 400 12.5px/1 var(--font-mono);
    color: var(--faint);
    white-space: nowrap;
  }
  .insight {
    font-size: clamp(18px, 1.8vw, 20px);
    line-height: 1.6;
    color: var(--fg);
    text-wrap: pretty;
  }
  .figures {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
  }
  .figures div {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-deep);
  }
  dd {
    margin: 0;
    font: 600 clamp(24px, 2.6vw, 30px) / 1.1 var(--font-body);
    letter-spacing: -0.01em;
  }
  .figures .lead dd {
    color: var(--hue);
  }
  dt {
    font-size: 13.5px;
    color: var(--faint);
  }

  /* ---------- Arrival ---------- */
  :global(html.js) .scene .ask,
  :global(html.js) .scene .answer > :global(*) {
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.3, 0.7, 0.3, 1);
  }
  :global(html.js) .scene:not(.in) .ask,
  :global(html.js) .scene:not(.in) .answer > :global(*) {
    opacity: 0;
    transform: translateY(14px);
  }
  .scene .answer > :global(:nth-child(2)) {
    transition-delay: 0.12s;
  }
  .scene .answer > :global(:nth-child(3)) {
    transition-delay: 0.22s;
  }
  .scene .answer > :global(:nth-child(4)) {
    transition-delay: 0.3s;
  }
  .scene .answer > :global(:nth-child(n + 5)) {
    transition-delay: 0.38s;
  }
</style>

<script>
  const scenes = [...document.querySelectorAll<HTMLElement>(".scene")];
  const railLinks = [...document.querySelectorAll<HTMLAnchorElement>(".rail a[data-scene]")];
  const railList = document.querySelector<HTMLElement>(".rail ol");
  const fill = document.querySelector<HTMLElement>(".track-fill");
  const mFill = document.querySelector<HTMLElement>(".mbar-fill");
  const mLabel = document.querySelector<HTMLElement>(".mbar-label");
  const unit = mLabel?.textContent?.split(" ")[0] ?? "";
  const pad = (n: number) => String(n).padStart(2, "0");

  // ---- Arrival: reveal each scene once, as it comes into view ----
  if ("IntersectionObserver" in window) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("in");
          seen.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -18% 0px" },
    );
    scenes.forEach((s) => seen.observe(s));
  } else {
    scenes.forEach((s) => s.classList.add("in"));
  }

  // ---- Progress: rail on wide screens, bar on narrow ones ----
  function update() {
    const mark = window.innerHeight * 0.35;
    let active = 0;
    scenes.forEach((s, i) => {
      if (s.getBoundingClientRect().top <= mark) active = i;
    });
    const r = scenes[active].getBoundingClientRect();
    const within = Math.min(1, Math.max(0, (mark - r.top) / Math.max(1, r.height)));

    railLinks.forEach((a, i) => {
      a.classList.toggle("active", i === active);
      a.classList.toggle("done", i < active);
      if (i === active) a.setAttribute("aria-current", "step");
      else a.removeAttribute("aria-current");
    });
    if (fill && railLinks.length) {
      const dot = (i: number) => railLinks[i].querySelector(".dot")!.getBoundingClientRect().top;
      const y = dot(active) - dot(0) + (dot(Math.min(active + 1, railLinks.length - 1)) - dot(active)) * within;
      fill.style.height = `${Math.max(0, y)}px`;
    }
    if (mFill) mFill.style.width = `${((active + within) / scenes.length) * 100}%`;
    if (mLabel) {
      const label = railLinks[active]?.querySelector(".rail-label")?.textContent ?? "";
      mLabel.textContent = `${unit} ${pad(active + 1)} of ${pad(scenes.length)} · ${label}`;
    }
  }
  if (railList) {
    const setH = () => railList.parentElement?.style.setProperty("--rail-h", `${railList.offsetHeight}px`);
    setH();
    window.addEventListener("resize", setH);
  }
  let queued = false;
  window.addEventListener(
    "scroll",
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    },
    { passive: true },
  );
  window.addEventListener("resize", update);
  update();

  // ---- Copy buttons on prompts and commands ----
  document.querySelectorAll<HTMLButtonElement>(".block .block-copy").forEach((btn) =>
    btn.addEventListener("click", async () => {
      const text = btn.closest(".block")?.querySelector("pre")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(text);
        btn.dataset.done = "";
        btn.textContent = "Copied";
        setTimeout(() => {
          delete btn.dataset.done;
          btn.textContent = "Copy";
        }, 1600);
      } catch {
        btn.textContent = "Select and copy";
      }
    }),
  );
</script>
