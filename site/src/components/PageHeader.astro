---
/**
 * Interior-page header. The landing page has its own two-column hero
 * (see index.astro); every other page opens with this.
 *
 * `titleEm` renders as a serif-italic gradient clause, the same emphasis
 * treatment nexql.astrx.dev and nexql-themes.astrx.dev use in their headlines.
 */
interface Props {
  kicker?: string;
  title: string;
  titleEm?: string;
  lede?: string;
}

const { kicker, title, titleEm, lede } = Astro.props;
---

<header class="mcp-page-head">
  {kicker && <p class="nx-kicker">{kicker}</p>}
  <h1 class="mcp-page-title">
    {title}{titleEm && <> <em>{titleEm}</em></>}
  </h1>
  {lede && <p class="mcp-page-lede">{lede}</p>}
  {
    Astro.slots.has("actions") && (
      <div class="mcp-page-actions">
        <slot name="actions" />
      </div>
    )
  }
</header>
