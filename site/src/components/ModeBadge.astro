---
import type { Mode } from "../data/docs";

interface Props {
  mode: Mode;
}
const { mode } = Astro.props;
const label = { read: "Works in read mode", write: "Needs write mode", admin: "Needs admin mode" }[mode];
---

<span class:list={["mode", mode]} title={label}>{label}</span>

<style>
  .mode {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: 500 12.5px/1 var(--font-body);
    padding: 7px 10px;
    border-radius: 8px;
    border: 1px solid;
    white-space: nowrap;
  }
  .mode::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .read {
    color: var(--ok);
    border-color: color-mix(in srgb, var(--ok) 35%, transparent);
  }
  .write {
    color: var(--nex-amber);
    border-color: color-mix(in srgb, var(--nex-amber) 45%, transparent);
  }
  .admin {
    color: var(--warn);
    border-color: color-mix(in srgb, var(--warn) 45%, transparent);
  }
</style>
