  .msg.ai th {
    font: 500 11.5px/1.2 var(--font-mono);
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .msg.ai td:not(:first-child),
  .msg.ai th:not(:first-child) {
    text-align: right;
    font-family: var(--font-mono);
  }
  .tool {
    font: 13px/1.5 var(--font-mono);
    color: var(--muted);
    padding: 7px 10px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--panel);
    justify-self: start;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .t-name {
    color: var(--kw);
    font-weight: 500;
  }
  .t-arg {
    color: var(--str);
  }
  .t-out {
    color: var(--faint);
  }
  .tool.ok .t-out {
    color: var(--ok);
  }
  /* Replay: hidden until the chat scrolls into view, then in sequence. */
  :global(.js) [data-replay] .chat-body > * {
    opacity: 0;
    transform: translateY(8px);
  }
  :global(.js) [data-replay].play .chat-body > * {
    animation: rise 0.45s ease-out forwards;
    animation-delay: calc(var(--d) * 0.9s);
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .behind {
    list-style: none;
    counter-reset: b;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .behind li {
    counter-increment: b;
    position: relative;
    padding: 2px 0 0 46px;
    color: var(--muted);
    font-size: 15.5px;
  }
  .behind li b {
    color: var(--fg);
    display: block;
  }
  .behind li::before {
    content: counter(b);
    position: absolute;
    left: 0;
    top: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font: 500 13px/1 var(--font-mono);
    color: var(--on-grad);
    background: var(--nex-grad);
  }
  .prompts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
    max-width: 720px;
  }
  .prompts li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 10px 10px 16px;
    border: 1px solid;
    border-color: var(--bevel-border);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: var(--shadow-1);
  }
  .copy-inline {
    flex: none;
    min-height: 32px;
    padding: 4px 10px;
    border-radius: 7px;
    border: 1px solid;
    border-color: var(--bevel-border);
    background: var(--control-bg);
    color: var(--muted);
    font: 500 12px/1 var(--font-mono);
    cursor: pointer;
    box-shadow: var(--control-shadow);
    transition: background 0.15s, box-shadow 0.15s, color 0.15s, transform 0.15s;
  }
  .copy-inline:hover {
    color: var(--fg);
    background: var(--control-bg-hover);
    box-shadow: var(--control-shadow-hover);
  }
  .copy-inline:active {
    box-shadow: var(--control-shadow-active);
  }
  .copy-inline[data-done] {
    color: var(--ok);
    border-color: var(--ok);
  }

  /* ---------- Stop 5: more ---------- */
  .board {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 1080px) {
    .board {
      grid-template-columns: 1fr 1.15fr 1fr;
      align-items: stretch;
    }
  }
  .frame {
    border: 1px solid;
    border-color: var(--bevel-border);
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--shadow-2);
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
  }
  .frame-no {
    font: 500 12px/1.2 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .mini-chat {
    display: grid;
    gap: 8px;
  }
  .mini-chat .msg {
    font-size: 14px;
    max-width: 100%;
  }
  .browser {
    border: 1px solid var(--chrome-line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--chrome-bg);
    color: var(--chrome-fg);
  }
  .b-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    background: var(--chrome-bar);
  }
  .b-bar .dots i {
    background: var(--chrome-dot);
  }
  .b-url {
    flex: 1;
    min-width: 0;
    background: var(--chrome-url-bg);
    border-radius: 6px;
    padding: 3px 8px;
    font: 12px/1.4 var(--font-mono);
    color: var(--chrome-url-fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .b-page {
    padding: 14px;
    display: grid;
    gap: 10px;
  }
  .b-title {
    font-weight: 700;
  }
  .b-page dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3px 12px;
    margin: 0;
    padding: 9px 11px;
    border: 1px solid var(--chrome-line);
    border-radius: 8px;
    font-size: 13px;
  }
  .b-page dt {
    color: var(--chrome-muted);
  }
  .b-page dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .b-pw {
    border: 1px solid var(--chrome-field-line);
    border-radius: 8px;
    padding: 7px 10px;
    background: var(--chrome-field-bg);
    font-family: var(--font-mono);
    letter-spacing: 2px;
    min-height: 34px;
  }
  .typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    border-right: 2px solid var(--chrome-caret);
  }
  :global(.js) .board.play .typed {
    animation: type 2.4s steps(12) 0.4s both;
  }
  @keyframes type {
    from {
      width: 0;
    }
    to {
      width: 12ch;
    }
  }
  .b-btn {
    text-align: center;
    padding: 8px;
    border-radius: 8px;
    background: var(--chrome-btn);
    color: var(--chrome-btn-fg);
    font-weight: 600;
    font-size: 14px;
  }
  .facts {
    display: grid;
    gap: 16px;
    margin-top: 24px;
    color: var(--muted);
    font-size: 15px;
  }
  @media (min-width: 720px) {
    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }
  .warn {
    margin-top: 20px;
    padding: 12px 16px;
    border-radius: 10px;
    background: var(--warn-wash);
    border: 1px solid var(--warn-line);
    color: var(--muted);
    font-size: 15px;
  }
  .warn b {
    color: var(--warn);
  }
  .warn + .small {
    margin-top: 14px;
  }

  /* ---------- Stop 6: safe ---------- */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 14px;
    margin-top: 28px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    border-radius: 14px;
    border: 1px solid;
    border-color: var(--bevel-border);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }
  .card::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--nex-grad);
    opacity: var(--card-edge);
  }
  .card h3 {
    font-size: 17px;
  }
  .card p {
    color: var(--muted);
    font-size: 14.5px;
    flex: 1;
  }
  .card .proof {
    align-self: flex-start;
    font-size: 12.5px;
    color: var(--num);
    background: var(--bg-deep);
  }
  .card .more {
    margin-top: auto;
    font-size: 14px;
  }

  /* ---------- Arrived ---------- */
  .arrived {
    position: relative;
    padding: 40px 28px 36px;
    border-radius: 20px;
    border: 1px solid var(--edge);
    background: var(--nex-grad-soft), var(--panel);
    box-shadow: var(--shadow-3);
    overflow: hidden;
  }
  .arrived > .ribbon {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    border-radius: 0;
  }
  .faq {
    display: grid;
    gap: 8px;
    margin-top: 24px;
  }
  .faq details {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
    padding: 0 16px;
  }
  .faq summary {
    cursor: pointer;
    padding: 13px 0;
    font-weight: 500;
  }
  .faq details p {
    padding-bottom: 14px;
    color: var(--muted);
    font-size: 15px;
  }
  .faq [data-for].on {
    display: inline;
  }
  .picked [data-for].on {
    display: inline;
  }
  @media (max-width: 719px) {
    .arrived {
      padding: 32px 18px 28px;
    }
  }
</style>

<script>
  type Kind = "bundle" | "cli" | "other";
  const root = document.documentElement;
  root.classList.add("js");

  const store = {
    get(k: string) {
      try {
        return localStorage.getItem(k);
      } catch {
        return null;
      }
    },
    set(k: string, v: string) {
      try {
        localStorage.setItem(k, v);
      } catch {
        /* private mode: the choice just isn't remembered */
      }
    },
  };

  const fillAll = (key: string, value: string) => {
    document.querySelectorAll<HTMLElement>(`[data-fill="${key}"]`).forEach((el) => (el.textContent = value));
  };

  // ---- Stop 1: the app picked shapes every later stop ----
  const appButtons = [...document.querySelectorAll<HTMLButtonElement>(".app")];
  function pickApp(id: string, remember: boolean) {
    const btn = appButtons.find((b) => b.dataset.app === id) ?? appButtons[0];
    appButtons.forEach((b) => b.setAttribute("aria-checked", String(b === btn)));
    const kind = btn.dataset.kind as Kind;
    document.querySelectorAll<HTMLElement>("[data-for]").forEach((el) => {
      el.classList.toggle("on", (el.dataset.for ?? "").split(" ").includes(kind));
    });
    fillAll("app", btn.dataset.name ?? "");
    fillAll("client", btn.dataset.client || "claude-code");
    if (remember) {
      store.set("nexql-tour-app", btn.dataset.app ?? "");
      const url = new URL(location.href);
      url.searchParams.set("app", btn.dataset.app ?? "");
      history.replaceState(null, "", url);
    }
  }
  // Radiogroups: one tab stop, arrows move the choice. Without JS every button stays in tab order.
  function roam(buttons: HTMLButtonElement[], pick: (b: HTMLButtonElement) => void) {
    const sync = () => {
      const current = buttons.find((b) => b.getAttribute("aria-checked") === "true") ?? buttons[0];
      buttons.forEach((b) => (b.tabIndex = b === current ? 0 : -1));
    };
    buttons.forEach((b, i) => {
      b.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = buttons[(i + step + buttons.length) % buttons.length];
        pick(next);
        next.focus();
      });
    });
    return sync;
  }

  let syncAppTab = () => {};
  const pickAppAndTab = (id: string, remember: boolean) => {
    pickApp(id, remember);
    syncAppTab();
  };
  appButtons.forEach((b) => b.addEventListener("click", () => pickAppAndTab(b.dataset.app ?? "", true)));
  syncAppTab = roam(appButtons, (b) => pickAppAndTab(b.dataset.app ?? "", true));
  pickAppAndTab(new URLSearchParams(location.search).get("app") ?? store.get("nexql-tour-app") ?? "claude-desktop", false);

  // ---- Stop 2: download for this computer ----
  (async () => {
    const LABELS: Record<string, string> = {
      "darwin-arm64": "macOS (Apple silicon)",
      "darwin-x64": "macOS (Intel)",
      "win32-x64": "Windows",
      "linux-x64": "Linux (x64)",
      "linux-arm64": "Linux (arm64)",
    };
    type UAData = { platform?: string; getHighEntropyValues?: (h: string[]) => Promise<{ architecture?: string }> };
    const uaData = (navigator as Navigator & { userAgentData?: UAData }).userAgentData;
    const platform = (uaData?.platform || navigator.platform || "").toLowerCase();
    const ua = navigator.userAgent.toLowerCase();
    let id: string | null = null;
    let sure = true;
    if (platform.includes("win") || ua.includes("windows")) id = "win32-x64";
    else if (platform.includes("mac") || ua.includes("mac os")) {
      // Only Chromium reports the CPU; nearly every Mac sold since 2021 is arm64.
      const arch = await uaData?.getHighEntropyValues?.(["architecture"]).catch(() => undefined);
      id = arch?.architecture === "x86" ? "darwin-x64" : "darwin-arm64";
      sure = arch?.architecture != null;
    } else if (platform.includes("linux") || ua.includes("linux")) {
      id = ua.includes("aarch64") || ua.includes("arm64") ? "linux-arm64" : "linux-x64";
      sure = false;
    }
    const target = id && document.querySelector<HTMLAnchorElement>(`.dl-list a[data-bundle="${id}"]`);
    const primary = document.getElementById("dl-primary") as HTMLAnchorElement | null;
    const label = document.getElementById("dl-label");
    if (!id || !target || !primary || !label) return;
    primary.href = target.href;
    label.textContent = LABELS[id];
    const hint = document.getElementById("dl-hint");
    if (hint && !sure && id === "darwin-arm64") hint.textContent = "On an Intel Mac? Use macOS (Intel) below. Other downloads:";
  })();

  // ---- Stop 3: platform tips and the address builder ----
  const builder = document.querySelector<HTMLFormElement>(".builder");
  function renderAddress() {
    if (!builder) return;
    const v = (n: string) => (builder.elements.namedItem(n) as HTMLInputElement).value.trim();
    fillAll("user", v("user") || "user");
    fillAll("host", v("host") || "host");
    fillAll("port", v("port") || "5432");
    fillAll("db", v("db") || "postgres");
    fillAll("query", v("ssl") ? `?sslmode=${v("ssl")}` : "");
  }
  builder?.addEventListener("input", renderAddress);
  const platformButtons = [...document.querySelectorAll<HTMLButtonElement>(".platform")];
  let syncPlatformTab = () => {};
  function selectPlatform(b: HTMLButtonElement) {
    platformButtons.forEach((x) => x.setAttribute("aria-checked", String(x === b)));
    document.querySelectorAll<HTMLElement>("[data-tip]").forEach((t) => (t.hidden = t.dataset.tip !== b.dataset.platform));
    if (builder) {
      (builder.elements.namedItem("host") as HTMLInputElement).value = b.dataset.host ?? "";
      (builder.elements.namedItem("port") as HTMLInputElement).value = b.dataset.port ?? "";
      (builder.elements.namedItem("ssl") as HTMLSelectElement).value = b.dataset.ssl ?? "";
      renderAddress();
    }
    syncPlatformTab();
  }
  platformButtons.forEach((b) => b.addEventListener("click", () => selectPlatform(b)));
  syncPlatformTab = roam(platformButtons, selectPlatform);
  syncPlatformTab();

  // ---- Copy buttons ----
  async function copyText(text: string, btn: HTMLElement) {
    try {
      await navigator.clipboard.writeText(text);
      btn.dataset.done = "";
      btn.textContent = "Copied";
      setTimeout(() => {
        delete btn.dataset.done;
        btn.textContent = "Copy";
      }, 1600);
    } catch {
      btn.textContent = "Select and copy";
    }
  }
  document.querySelectorAll<HTMLButtonElement>(".code .copy").forEach((btn) =>
    btn.addEventListener("click", () => {
      const pre = btn.parentElement?.querySelector("pre");
      if (!pre) return;
      const clone = pre.cloneNode(true) as HTMLElement;
      clone.querySelectorAll(".p, .c").forEach((n) => n.remove());
      const text = (clone.textContent ?? "")
        .split("\n")
        .map((l) => l.trimEnd())
        .filter((l) => l.trim() !== "")
        .join("\n");
      copyText(text, btn);
    }),
  );
  document.querySelectorAll<HTMLButtonElement>(".copy-inline").forEach((btn) =>
    btn.addEventListener("click", () => copyText(btn.dataset.text ?? "", btn)),
  );

  // ---- Replays: play when scrolled into view ----
  const players = document.querySelectorAll<HTMLElement>("[data-replay], .board");
  const playObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("play");
          playObs.unobserve(e.target);
        }
      });
    },
    { threshold: 0.35 },
  );
  players.forEach((p) => playObs.observe(p));
  document.querySelectorAll<HTMLButtonElement>(".replay").forEach((btn) =>
    btn.addEventListener("click", () => {
      const chat = btn.closest<HTMLElement>("[data-replay]");
      if (!chat) return;
      chat.classList.remove("play");
      void chat.offsetWidth;
      chat.classList.add("play");
    }),
  );

  // ---- Route progress: rail on wide screens, bar on narrow ones ----
  const stops = [...document.querySelectorAll<HTMLElement>(".stop")];
  const railLinks = [...document.querySelectorAll<HTMLAnchorElement>(".rail a[data-stop]")];
  const railList = document.querySelector<HTMLElement>(".rail ol");
  const fill = document.querySelector<HTMLElement>(".track-fill");
  const mFill = document.querySelector<HTMLElement>(".mbar-fill");
  const mLabel = document.querySelector<HTMLElement>(".mbar-label");
  const pad = (n: number) => String(n).padStart(2, "0");

  function update() {
    const mark = window.innerHeight * 0.35;
    let active = 0;
    stops.forEach((s, i) => {
      if (s.getBoundingClientRect().top <= mark) active = i;
    });
    const s = stops[active];
    const r = s.getBoundingClientRect();
    const within = Math.min(1, Math.max(0, (mark - r.top) / Math.max(1, r.height)));
    const progress = (active + within) / stops.length;

    railLinks.forEach((a, i) => {
      a.classList.toggle("active", i === active);
      a.classList.toggle("done", i < active);
      if (i === active) a.setAttribute("aria-current", "step");
      else a.removeAttribute("aria-current");
    });
    if (fill && railList && railLinks.length) {
      const first = railLinks[0].querySelector(".dot")!.getBoundingClientRect();
      const cur = railLinks[active].querySelector(".dot")!.getBoundingClientRect();
      const next = railLinks[Math.min(active + 1, railLinks.length - 1)].querySelector(".dot")!.getBoundingClientRect();
      const y = cur.top - first.top + (next.top - cur.top) * within;
      fill.style.height = `${Math.max(0, y)}px`;
    }
    if (mFill) mFill.style.width = `${progress * 100}%`;
    if (mLabel) {
      const label = railLinks[active]?.querySelector(".rail-label")?.textContent ?? "";
      mLabel.textContent = `Stop ${pad(active + 1)} of ${pad(stops.length)} · ${label}`;
    }
  }
  if (railList) {
    const setH = () => railList.parentElement?.style.setProperty("--rail-h", `${railList.offsetHeight}px`);
    setH();
    window.addEventListener("resize", setH);
  }
  let queued = false;
  window.addEventListener(
    "scroll",
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    },
    { passive: true },
  );
  window.addEventListener("resize", update);
  update();
</script>
