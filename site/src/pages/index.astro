---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Code from "../components/Code.astro";
import { APPS, DEFAULT_APP, PLATFORMS, PROMPTS, STOPS } from "../data/tour";
import { FACTS, REPO_URL } from "../data/site";

const DOWNLOAD = `${REPO_URL}/releases/latest/download`;
const BUNDLES = [
  { id: "darwin-arm64", label: "macOS (Apple silicon)" },
  { id: "darwin-x64", label: "macOS (Intel)" },
  { id: "win32-x64", label: "Windows" },
  { id: "linux-x64", label: "Linux (x64)" },
  { id: "linux-arm64", label: "Linux (arm64)" },
];
const pad = (n: number) => String(n).padStart(2, "0");
const stopNo = (id: string) => pad(STOPS.findIndex((s) => s.id === id) + 1);
const nextOf = (id: string) => STOPS[STOPS.findIndex((s) => s.id === id) + 1];
const defaultApp = APPS.find((a) => a.id === DEFAULT_APP)!;

const fill = (key: string, value: string) => `<span data-fill="${key}">${value}</span>`;
const URL_CMD = `'postgres://${fill("user", "app_reader")}@${fill("host", "localhost")}:${fill("port", "5432")}/${fill("db", "appdb")}${fill("query", "")}'`;
---

<BaseLayout
  title="NexQL MCP — a guided tour from install to your first answer"
  description="Connect Claude, Cursor, VS Code, Codex, Gemini CLI or another AI app to your Postgres database in about five minutes. A stop-by-stop tour: pick your app, install, connect, ask, add more databases, and stay in control. Read-only by default, personal data masked."
>
  <SiteHeader current="tour" />

  <main id="main" tabindex="-1">
    <!-- Start -->
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="pill"><span class="live-dot" aria-hidden="true"></span>A guided tour · about 5 minutes</p>
        <h1>
          Ask your Postgres database{" "}
          <span class="serif-em grad-text">anything</span>, in plain English.
        </h1>
        <p class="lede">
          NexQL MCP connects your AI app to your database. It runs on your computer, reads by default, and masks personal data
          before results reach the AI. This tour takes you from nothing to your first answer, one stop at a time.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#app">Start the tour</a>
          <a class="btn btn-ghost" href="#ask">Already set up? Go to stop {stopNo("ask")}</a>
        </div>
      </div>

      <aside class="ticket" aria-label="Your route">
        <div class="ticket-head">
          <span class="mono-label">Your route</span>
          <span class="mono-label">{STOPS.length} stops</span>
        </div>
        <ol class="route">
          {
            STOPS.map((s, i) => (
              <li>
                <a href={`#${s.id}`}>
                  <span class="route-dot" />
                  <span class="route-no">{pad(i + 1)}</span>
                  <span class="route-label">{s.label}</span>
                  <span class="route-min">{s.minutes}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <div class="ticket-foot">
          <span>Works with Postgres {FACTS.pgVersions}</span>
          <span>{FACTS.toolCount} tools · {FACTS.license}</span>
        </div>
      </aside>
    </section>

    <!-- Mobile progress, under the header -->
    <div class="mbar">
      <div class="mbar-fill"></div>
      <span class="mbar-label">Stop 01 of {pad(STOPS.length)} · {STOPS[0].label}</span>
    </div>

    <div class="tour wrap">
      <nav class="rail" aria-label="Tour stops">
        <div class="track"><div class="track-fill"></div></div>
        <ol>
          {
            STOPS.map((s, i) => (
              <li>
                <a href={`#${s.id}`} data-stop={s.id}>
                  <span class="dot" />
                  <span class="rail-text">
                    <span class="rail-no">Stop {pad(i + 1)}</span>
                    <span class="rail-label">{s.label}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="rail-app">Touring with <b data-fill="app">{defaultApp.name}</b> · <a href="#app">change</a></p>
      </nav>

      <div class="stops">
        <!-- 01 Pick your app -->
        <section class="stop" id="app">
          <header class="stop-head">
            <span class="stop-no">Stop <b>{stopNo("app")}</b></span>
            <span class="stop-time">{STOPS[0].minutes}</span>
          </header>
          <h2>Which app do you want to <span class="serif-em">talk to</span> your database from?</h2>
          <p class="lede">The rest of the tour changes to match. You can come back and switch at any time.</p>

          <div class="apps" role="radiogroup" aria-label="Your AI app">
            {
              APPS.map((a) => (
                <button
                  type="button"
                  class="app"
                  role="radio"
                  aria-checked={a.id === DEFAULT_APP ? "true" : "false"}
                  data-app={a.id}
                  data-kind={a.kind}
                  data-name={a.name}
                  data-client={a.client ?? ""}
                >
                  <span class="app-name">
                    {a.name}
                    {a.id === DEFAULT_APP && <span class="app-tag">Easiest</span>}
                  </span>
                  <span class="app-hint">{a.hint}</span>
                </button>
              ))
            }
          </div>
          <p class="picked">
            <span class="ok-dot"></span> Touring with <b data-fill="app">{defaultApp.name}</b>.
            <span data-for="other">Your app needs to support local (stdio) MCP servers. Most desktop and editor apps do. ChatGPT chat doesn't yet; for Codex in the ChatGPT desktop app, pick Codex.</span>
          </p>

          <a class="next" href={`#${nextOf("app").id}`}>Next stop <b>{nextOf("app").label}</b> <span aria-hidden="true">→</span></a>
        </section>

        <!-- 02 Install -->
        <section class="stop" id="install">
          <header class="stop-head">
            <span class="stop-no">Stop <b>{stopNo("install")}</b></span>
            <span class="stop-time">{STOPS[1].minutes}</span>
          </header>

          <div data-for="bundle">
            <h2>Install it like any <span class="serif-em">app</span>.</h2>
            <p class="lede">One file. No terminal, no Node, no config files.</p>
            <div class="install-box">
              <a id="dl-primary" class="btn btn-primary dl" href={`${DOWNLOAD}/nexql-mcp-darwin-arm64.mcpb`}>
                Download for <span id="dl-label">macOS (Apple silicon)</span>
              </a>
              <p class="small" id="dl-hint">Not your computer? Pick another:</p>
              <ul class="dl-list">
                {BUNDLES.map((b) => (
                  <li><a href={`${DOWNLOAD}/nexql-mcp-${b.id}.mcpb`} data-bundle={b.id}>{b.label}</a></li>
                ))}
              </ul>
            </div>
            <ol class="steps">
              <li><b>Double-click the downloaded <code>.mcpb</code> file.</b> Claude Desktop opens an install dialog.</li>
              <li><b>No dialog?</b> In Claude Desktop, open <b>Settings → Extensions</b> and drop the file there.</li>
              <li><b>Keep the dialog open.</b> It asks for your database next, which is the next stop.</li>
            </ol>
          </div>

          <div data-for="cli other">
            <h2>Nothing to install, <span class="serif-em">really</span>.</h2>
            <p class="lede">
              <b data-fill="app">{defaultApp.name}</b> starts NexQL through <code>npx</code>, which fetches the latest version
              when it's needed. You only need Node.js 18 or newer. Check with:
            </p>
            <Code html={`<span class="p">$ </span>node --version`} />
            <p class="note">
              Prints <code>v18</code> or higher? You're set. Otherwise install Node.js from
              <a href="https://nodejs.org/">nodejs.org</a> (the LTS version), then reopen your terminal.
            </p>
          </div>

          <a class="next" href={`#${nextOf("install").id}`}>Next stop <b>{nextOf("install").label}</b> <span aria-hidden="true">→</span></a>
        </section>

        <!-- 03 Connect -->
        <section class="stop" id="connect">
          <header class="stop-head">
            <span class="stop-no">Stop <b>{stopNo("connect")}</b></span>
            <span class="stop-time">{STOPS[2].minutes}</span>
          </header>
          <h2>Point it at your <span class="serif-em">database</span>.</h2>
          <p class="lede">First, find your database's address. Where does it live?</p>

          <div class="platforms" role="radiogroup" aria-label="Where your database lives">
            {
              PLATFORMS.map((p, i) => (
                <button
                  type="button"
                  class="platform"
                  role="radio"
                  aria-checked={i === 0 ? "true" : "false"}
                  data-platform={p.id}
                  data-host={p.host}
                  data-port={p.port}
                  data-ssl={p.ssl}
                >
                  {p.icon ? <img src={`/assets/platforms/${p.icon}.svg`} alt="" width="20" height="20" loading="lazy" /> : <span class="pf-dot" />}
                  {p.name}
                </button>
              ))
            }
          </div>
          {
            PLATFORMS.map((p, i) => (
              <div class="pf-tip" data-tip={p.id} hidden={i !== 0}>
                <p><span class="mono-label">Where to look</span>{p.where}</p>
                <p><span class="mono-label">Can your computer reach it?</span>{p.network}</p>
              </div>
            ))
          }

          <h3 class="sub">Build the address</h3>
          <p class="small">
            Fill in what you found. There's deliberately no password box: type your real password only into your app or NexQL's
            own page on your computer, never into a website, including this one.
          </p>
          <form class="builder" autocomplete="off" onsubmit="return false">
            <label>User <input name="user" value="app_reader" spellcheck="false" /></label>
            <label class="wide">Host <input name="host" value="localhost" spellcheck="false" /></label>
            <label>Port <input name="port" value="5432" inputmode="numeric" spellcheck="false" /></label>
            <label>Database <input name="db" value="appdb" spellcheck="false" /></label>
            <label>SSL
              <select name="ssl">
                <option value="">Off (local)</option>
                <option value="require">require</option>
                <option value="verify-full">verify-full</option>
              </select>
            </label>
          </form>
          <figure class="code url-out">
            <pre><span class="u-s">postgres://</span><span class="u-u" data-fill="user">app_reader</span>:<span class="u-p">YOUR_PASSWORD</span>@<span class="u-h" data-fill="host">localhost</span>:<span class="u-n" data-fill="port">5432</span>/<span class="u-d" data-fill="db">appdb</span><span class="u-q" data-fill="query"></span></pre>
            <button class="copy" type="button" aria-label="Copy the address">Copy</button>
          </figure>

          <div data-for="bundle">
            <h3 class="sub">Fill in Claude Desktop's dialog</h3>
            <div class="form-mock" role="group" aria-label="Claude Desktop install dialog, as an example">
              <div class="fm-row">
                <span class="fm-label">Database URL</span>
                <span class="fm-field mono">postgres://<span data-fill="user">app_reader</span>:<mark>your-real-password</mark>@<span data-fill="host">localhost</span>:<span data-fill="port">5432</span>/<span data-fill="db">appdb</span><span data-fill="query"></span></span>
                <span class="fm-help">Paste the address, then replace YOUR_PASSWORD here, in the dialog.</span>
              </div>
              <div class="fm-row">
                <span class="fm-label">Allow changes to data</span>
                <span class="fm-toggle" aria-hidden="true"><span></span></span>
                <span class="fm-help">Leave it off. Claude can then only read.</span>
              </div>
              <div class="fm-row">
                <span class="fm-label">Schemas</span>
                <span class="fm-field mono faint">public,sales</span>
                <span class="fm-help">Optional. Leave empty to let Claude see every schema.</span>
              </div>
            </div>
            <p class="note">Click <b>Install</b>, then make sure the extension is switched on. Claude Desktop keeps the URL in your system's secure storage.</p>
          </div>

          <div data-for="cli other">
            <h3 class="sub">Save it with NexQL's setup page</h3>
            <p class="small">Run this in a terminal. A page opens on your computer (127.0.0.1), not on the web.</p>
            <Code html={`<span class="p">$ </span>npx -y nexql-mcp@latest setup`} />
            <ol class="steps">
              <li><b>Add a database</b> with the details above, type the password on that page, and click <b>Test</b>. NexQL keeps the password in your system keychain.</li>
              <li data-for="cli"><b>Open Clients</b>, tick <b data-fill="app">{defaultApp.name}</b> and click <b>Apply</b>.</li>
              <li data-for="other"><b>Open Clients</b> and copy the snippet for your app, or use the JSON below.</li>
              <li><b>Restart <span data-fill="app">{defaultApp.name}</span></b> so it picks NexQL up.</li>
            </ol>
            <details class="alt">
              <summary>Prefer the terminal? Two commands do the same.</summary>
              <Code html={`<span class="p">$ </span>npx -y nexql-mcp@latest profile add mydb --url ${URL_CMD} --access-mode read
<span class="c"># asks for the password without showing it</span>`} />
              <div data-for="cli">
                <Code html={`<span class="p">$ </span>npx -y nexql-mcp@latest init <span data-fill="client">claude-code</span> --apply`} />
              </div>
              <div data-for="other">
                <p class="small">Then add this to your app's MCP settings:</p>
                <Code html={`{
  "mcpServers": {
    "nexql": {
      "command": "npx",
      "args": ["-y", "nexql-mcp@latest", "--profile", "mydb"]
    }
  }
}`} />
              </div>
            </details>
          </div>

          <aside class="tip">
            <span class="mono-label">Tip · least privilege</span>
            <p>
              Connect as a user that can only read. <code>npx -y nexql-mcp@latest profile readonly-role</code> prints the SQL
              to create one. If you connect as a superuser, NexQL stays read-only even when changes are switched on.
            </p>
          </aside>

          <a class="next" href={`#${nextOf("connect").id}`}>Next stop <b>{nextOf("connect").label}</b> <span aria-hidden="true">→</span></a>
        </section>

        <!-- 04 Ask -->
        <section class="stop" id="ask">
          <header class="stop-head">
            <span class="stop-no">Stop <b>{stopNo("ask")}</b></span>
            <span class="stop-time">{STOPS[3].minutes}</span>
          </header>
          <h2>Now just <span class="serif-em">ask</span>.</h2>
          <p class="lede">
            Open a new chat in <b data-fill="app">{defaultApp.name}</b> and ask a question about your data. Here's what happens
            behind the answer.
          </p>

          <div class="ask-grid">
            <div class="chat" data-replay>
              <div class="chat-top">
                <span class="dots"><i></i><i></i><i></i></span>
                <span class="mono-label" data-fill="app">{defaultApp.name}</span>
                <button type="button" class="replay">Replay</button>
              </div>
              <div class="chat-body">
                <p class="msg user" style="--d:0">Which products sold best last month?</p>
                <p class="tool" style="--d:1"><span class="t-name">search_schema</span> <span class="t-arg">"products sold"</span> <span class="t-out">→ orders.order_items, catalog.products</span></p>
                <p class="tool" style="--d:2"><span class="t-name">describe_object</span> <span class="t-arg">orders.order_items</span> <span class="t-out">→ 8 columns</span></p>
                <p class="tool" style="--d:3"><span class="t-name">run_select</span> <span class="t-arg">read-only</span> <span class="t-out">→ 5 rows · 41 ms</span></p>
                <div class="msg ai" style="--d:4">
                  <p>Your top seller last month was the <b>Trail Runner 2</b>, well ahead of the rest:</p>
                  <table>
                    <thead><tr><th>Product</th><th>Units</th><th>Revenue</th></tr></thead>
                    <tbody>
                      <tr><td>Trail Runner 2</td><td>1,284</td><td>$153,951</td></tr>
                      <tr><td>Merino Base Layer</td><td>906</td><td>$62,514</td></tr>
                      <tr><td>Summit Pack 30L</td><td>512</td><td>$58,880</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <ol class="behind">
              <li style="--d:1"><b>Finds the right tables</b> by searching an index of your schema kept on your computer, so it doesn't guess names.</li>
              <li style="--d:2"><b>Reads the exact columns</b> before writing any SQL.</li>
              <li style="--d:3"><b>Runs a read-only query.</b> Statements that change data are refused unless you allowed them.</li>
              <li style="--d:4"><b>Masks personal data</b> such as emails and phone numbers before the rows reach the AI.</li>
            </ol>
          </div>

          <h3 class="sub">Good first questions</h3>
          <ul class="prompts">
            {
              PROMPTS.map((p) => (
                <li>
                  <span>{p}</span>
                  <button type="button" class="copy-inline" data-text={p} aria-label={`Copy: ${p}`}>Copy</button>
                </li>
              ))
            }
          </ul>

          <a class="next" href={`#${nextOf("ask").id}`}>Next stop <b>{nextOf("ask").label}</b> <span aria-hidden="true">→</span></a>
        </section>

        <!-- 05 More databases -->
        <section class="stop" id="more">
          <header class="stop-head">
            <span class="stop-no">Stop <b>{stopNo("more")}</b></span>
            <span class="stop-time">{STOPS[4].minutes}</span>
          </header>
          <h2>More than one database? <span class="serif-em">Just ask</span> for it.</h2>
          <p class="lede">
            Tell your assistant where the other database is. NexQL opens a page on your computer where you type its password.
            Your assistant never sees it.
          </p>

          <ol class="board">
            <li class="frame">
              <span class="frame-no">1 · You ask</span>
              <div class="mini-chat">
                <p class="msg user">Also connect our billing database: db.internal, database billing, user billing_reader.</p>
                <p class="tool"><span class="t-name">add_database</span> <span class="t-arg">billing</span> <span class="t-out">→ page opened</span></p>
              </div>
            </li>
            <li class="frame">
              <span class="frame-no">2 · You confirm, on your computer</span>
              <div class="browser">
                <div class="b-bar"><span class="dots"><i></i><i></i><i></i></span><span class="b-url">127.0.0.1:41873/connect/…</span></div>
                <div class="b-page">
                  <p class="b-title">Connect "billing"</p>
                  <dl>
                    <dt>Host</dt><dd>db.internal</dd>
                    <dt>Database</dt><dd>billing</dd>
                    <dt>User</dt><dd>billing_reader</dd>
                    <dt>Access</dt><dd>Read-only</dd>
                  </dl>
                  <span class="b-pw"><span class="typed">••••••••••••</span></span>
                  <span class="b-btn">Test and connect</span>
                </div>
              </div>
            </li>
            <li class="frame">
              <span class="frame-no">3 · It's connected</span>
              <div class="mini-chat">
                <p class="tool ok"><span class="t-name">add_database</span> <span class="t-out">→ connected, read-only</span></p>
                <p class="msg ai">billing is connected. Paid invoices total <b>$64,844</b> across 1,200 invoices.</p>
              </div>
            </li>
          </ol>

          <div class="facts">
            <p><span class="mono-label">Why it's safe</span>The page lives on 127.0.0.1, works once, and expires after 10 minutes. You check the host and user before typing anything. New databases are always read-only.</p>
            <p><span class="mono-label">Then ask across them</span>"Compare last month's orders in shop with paid invoices in billing." Your assistant picks the right database for each part.</p>
          </div>
          <p class="warn">
            <b>Never paste a password into the chat.</b> Chats are stored by your AI provider. If you already did, change that
            password.
          </p>
          <p class="small" data-for="cli other">
            Setting several up at once? <code>npx -y nexql-mcp@latest setup</code> lets you add each database, then tick which
            ones <span data-fill="app">{defaultApp.name}</span> should see under Clients.
          </p>

          <a class="next" href={`#${nextOf("more").id}`}>Next stop <b>{nextOf("more").label}</b> <span aria-hidden="true">→</span></a>
        </section>

        <!-- 06 Stay in control -->
        <section class="stop" id="safe">
          <header class="stop-head">
            <span class="stop-no">Stop <b>{stopNo("safe")}</b></span>
            <span class="stop-time">{STOPS[5].minutes}</span>
          </header>
          <h2>You stay in <span class="serif-em">control</span>.</h2>
          <p class="lede">What NexQL does by default, so you can let your assistant explore without worrying.</p>

          <div class="cards">
            <article class="card">
              <h3>Read-only unless you say so</h3>
              <p>Every query runs in a read-only transaction. Changes need the switch turned on and a user that isn't a superuser.</p>
              <code class="proof">BEGIN READ ONLY</code>
              <a class="more" href="/docs/safety">Access modes and guardrails →</a>
            </article>
            <article class="card">
              <h3>Personal data is masked</h3>
              <p>Columns that look like emails, phone numbers, names, addresses or secrets come back as <code>&lt;redacted&gt;</code>.</p>
              <code class="proof">email → &lt;redacted&gt;</code>
              <a class="more" href="/docs/privacy">What gets masked →</a>
            </article>
            <article class="card">
              <h3>Passwords stay on your computer</h3>
              <p>NexQL stores them in your system keychain, or an encrypted file where there isn't one. Never in plain text.</p>
              <code class="proof">credential_provider = "keyring"</code>
              <a class="more" href="/docs/connections#where-passwords-live">Where passwords live →</a>
            </article>
            <article class="card">
              <h3>You know what leaves</h3>
              <p>NexQL runs locally and talks to your database directly. The tables it describes and the rows it returns become part of your chat, so your AI provider sees them.</p>
              <code class="proof">127.0.0.1 → your database</code>
              <a class="more" href="/docs/how-it-works">How a question travels →</a>
            </article>
          </div>

          <a class="next" href="#arrived">Final stop <b>You've arrived</b> <span aria-hidden="true">→</span></a>
        </section>

        <!-- Arrived -->
        <section class="arrived" id="arrived">
          <div class="ribbon"></div>
          <h2>You've <span class="serif-em grad-text">arrived</span>.</h2>
          <p class="lede">
            That's the whole route. If something on the way didn't work, the fixes below cover most problems.
          </p>
          <div class="faq">
            <details>
              <summary><span data-fill="app">{defaultApp.name}</span> doesn't show NexQL</summary>
              <p>
                Quit the app completely and open it again. <span data-for="bundle">In Claude Desktop, check <b>Settings → Extensions</b> shows NexQL switched on.</span>
                <span data-for="cli other">Then check the database itself with <code>npx -y nexql-mcp@latest --profile mydb doctor</code>.</span>
              </p>
            </details>
            <details>
              <summary>"Connection refused" or it times out</summary>
              <p>
                Your computer can't reach the database. Check the host and port, and that a firewall, security group or allow list
                lets your IP in. Cloud databases usually also need <code>sslmode=require</code>.
              </p>
            </details>
            <details>
              <summary>"password authentication failed"</summary>
              <p>The user or password is wrong. Run the setup again and retype the password on the setup page or in the dialog.</p>
            </details>
            <details>
              <summary>"permission denied for table …"</summary>
              <p>The user can't read that table. On Postgres 14 or newer, <code>GRANT pg_read_all_data TO app_reader;</code> lets it read everything.</p>
            </details>
            <details>
              <summary>It says changes are switched off</summary>
              <p>
                You're connected as a database superuser, so NexQL stays read-only. To allow changes, connect as a user that
                isn't a superuser and has the write privileges it needs.
              </p>
            </details>
          </div>
          <div class="hero-cta">
            <a class="btn btn-primary" href="/docs">Explore the docs</a>
