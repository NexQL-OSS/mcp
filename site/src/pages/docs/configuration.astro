---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import DocsNav from "../../components/DocsNav.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { docsNav } from "../../data/docs-nav";

const configToml = `default_profile = "local"

[profiles.local]
url = "postgres://dev@localhost:5432/appdb"
access_mode = "read"

[profiles.prod]
host = "prod.example.com"
dbname = "app"
user = "readonly_agent"
password_command = "op read op://vault/pg/password"
access_mode = "read"
schemas = ["public", "billing"]
deny_tables = ["auth.*"]
pii_columns = ["public.users.ssn", "public.users.email"]
max_rows = 200`;
---

<BaseLayout
  title="Configuration — NexQL MCP"
  description="Connection profiles in config.toml: access mode, schema allowlists, denied tables, PII masking, row caps and secret handling."
  canonical="https://nexql-mcp.astrx.dev/docs/configuration"
>
  <main id="main" class="mcp-main">
    <PageHeader
      kicker="Reference"
      title="A profile is more than"
      titleEm="a connection string."
      lede="Each profile carries its own access mode, schema allowlist, denied tables, masked columns and row cap — so a production profile can be genuinely restricted while a local one stays wide open, and switching is one tool call."
    />

    <Section>
      <div class="docs-layout">
        <DocsNav items={docsNav} />

        <div>
          <div class="mcp-prose">
            <p>
              Profiles live in <code>~/.config/nexql-mcp/config.toml</code>. Override the path with
              <code>--config</code> or <code>NEXQL_MCP_CONFIG</code>. A workspace can also carry its own
              <code>.nexql/config.toml</code>, discovered from <code>--workspace-root</code>.
            </p>
          </div>

          <CodeBlock label="~/.config/nexql-mcp/config.toml" copyLabel="config" code={configToml} />

          <h2 class="nx-title nx-title--sm">Profile fields</h2>
          <div class="ref-table-wrap">
            <table class="ref-table">
              <thead>
                <tr>
                  <th>Field</th>
                  <th>What it does</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>url</code></td>
                  <td>Full connection string. Mutually exclusive with the discrete fields below.</td>
                </tr>
                <tr>
                  <td><code>host</code> / <code>port</code> / <code>dbname</code> / <code>user</code></td>
                  <td>Discrete connection fields, for when a URL is awkward to assemble.</td>
                </tr>
                <tr>
                  <td><code>password_command</code></td>
                  <td>
                    Shell command run to fetch the password. Keeps the secret out of the file
                    entirely — point it at 1Password, Vault, or anything that prints to stdout.
                  </td>
                </tr>
                <tr>
                  <td><code>credential_provider</code></td>
                  <td>
                    Set to <code>aws-iam</code> to mint short-lived RDS IAM tokens instead of using a
                    static password.
                  </td>
                </tr>
                <tr>
                  <td><code>access_mode</code></td>
                  <td>
                    <code>read</code> (default), <code>write</code>, or <code>admin</code>. Enforced at
                    tool-call time, on top of a read-only transaction default.
                  </td>
                </tr>
                <tr>
                  <td><code>schemas</code></td>
                  <td>Allowlist. Anything outside it is invisible to the index and to queries.</td>
                </tr>
                <tr>
                  <td><code>deny_tables</code></td>
                  <td>Glob-matched blocklist, applied after the schema allowlist.</td>
                </tr>
                <tr>
                  <td><code>pii_columns</code></td>
                  <td>Fully-qualified columns to mask in results.</td>
                </tr>
                <tr>
                  <td><code>max_rows</code></td>
                  <td>Row cap for this profile. Per-call limits cannot exceed it.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h2 class="nx-title nx-title--sm">Where things live</h2>
          <div class="ref-table-wrap">
            <table class="ref-table">
              <thead>
                <tr>
                  <th>Path</th>
                  <th>Contents</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>~/.config/nexql-mcp/</code></td>
                  <td>config.toml and client wiring state</td>
                </tr>
                <tr>
                  <td><code>~/.local/share/nexql-mcp/</code></td>
                  <td>The schema index, per profile and database</td>
                </tr>
                <tr>
                  <td><code>.nexql/config.toml</code></td>
                  <td>Workspace-local profiles, discovered from the workspace root</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="mcp-note">
            <strong>Secrets never need to sit in the file.</strong> Inline
            <code>password</code> values migrate to the OS keyring on load, and
            <code>nexql-mcp profile migrate-secrets</code> moves any legacy plaintext across in one go.
            Profile exports omit secrets by construction.
          </p>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
