---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import DocsNav from "../../components/DocsNav.astro";
import { docsNav } from "../../data/docs-nav";
import { cliCommands, globalFlags, initClients } from "../../data/commands";

const root = cliCommands[0];
---

<BaseLayout
  title="CLI reference — NexQL MCP"
  description="Every nexql-mcp subcommand and flag, with the NEXQL_MCP_* environment variable that matches it."
  canonical="https://nexql-mcp.astrx.dev/docs/commands"
>
  <main id="main" class="mcp-main">
    <PageHeader
      kicker="Reference"
      title="Every flag,"
      titleEm="and its env var."
      lede="Anything you can pass on the command line can also be set through the environment as NEXQL_MCP_<UPPER_SNAKE>. Precedence runs connection string, then flags, then environment, then config file."
    />

    <Section>
      <div class="docs-layout">
        <DocsNav items={docsNav} />

        <div>
          <div class="mcp-prose">
            <p>
              <code>{root.usage}</code>
            </p>
            <p>{root.description}</p>
          </div>

          <h2 class="nx-title nx-title--sm">Global flags</h2>
          <div class="ref-table-wrap">
            <table class="ref-table">
              <thead>
                <tr>
                  <th>Flag</th>
                  <th>Environment</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                {
                  globalFlags.map((f) => (
                    <tr>
                      <td>
                        <code>{f.flag}</code>
                      </td>
                      <td>{f.env ? <code>{f.env}</code> : "—"}</td>
                      <td>{f.description}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h2 class="nx-title nx-title--sm">Subcommands</h2>
          {
            root.subcommands?.map((sub) => (
              <div class="tool-group">
                <div class="tool-group-head">
                  <h3 class="tool-group-title">
                    <code>nexql-mcp {sub.name}</code>
                  </h3>
                  {sub.usage && <span class="tool-group-count">{sub.usage}</span>}
                  <p class="tool-group-summary">{sub.description}</p>
                </div>

                {sub.flags?.map((f) => (
                  <div class="tool-row">
                    <div class="tool-row-name">
                      <code>{f.flag}</code>
                      {f.env && <span class="access-badge">{f.env}</span>}
                    </div>
                    <span class="tool-row-desc">{f.description}</span>
                  </div>
                ))}

                {sub.subcommands?.map((nested) => (
                  <div class="tool-row">
                    <div class="tool-row-name">
                      <code>
                        {sub.name} {nested.name}
                      </code>
                    </div>
                    <span class="tool-row-desc">
                      {nested.description}
                      {nested.flags && (
                        <>
                          {" "}
                          {nested.flags.map((f) => (
                            <>
                              <code>{f.flag}</code>{" "}
                            </>
                          ))}
                        </>
                      )}
                    </span>
                  </div>
                ))}
              </div>
            ))
          }

          <h2 class="nx-title nx-title--sm">Clients init knows about</h2>
          <div class="mcp-prose">
            <p>
              <code>nexql-mcp init &lt;client&gt;</code> writes the right config file for any of these.
              Run it with no argument to open the wizard instead.
            </p>
          </div>
          <div class="nx-mcp-tools">
            {
              initClients.map((c) => (
                <div class="nx-mcp-tool">
                  <code>{c}</code>
                  <span>nexql-mcp init {c}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
