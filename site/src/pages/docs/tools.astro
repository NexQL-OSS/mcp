---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import DocsNav from "../../components/DocsNav.astro";
import { docsNav } from "../../data/docs-nav";
import { toolGroups, toolCount } from "../../data/tools";
---

<BaseLayout
  title="Tool reference — NexQL MCP"
  description={`All ${toolCount} NexQL MCP tools by category, with the access mode each one requires.`}
  canonical="https://nexql-mcp.astrx.dev/docs/tools"
>
  <main id="main" class="mcp-main">
    <PageHeader
      kicker="Reference"
      title={`${toolCount} tools,`}
      titleEm="named for the job."
      lede="Every tool is listed to the client regardless of access mode — the mode is enforced when the call arrives, so an agent gets a refusal it can explain rather than a tool that is mysteriously absent."
    />

    <Section>
      <div class="docs-layout">
        <DocsNav items={docsNav} />

        <div>
          {
            toolGroups.map((group) => (
              <div class="tool-group" id={group.id}>
                <div class="tool-group-head">
                  <h2 class="tool-group-title">{group.title}</h2>
                  <span class="tool-group-count">{group.tools.length} tools</span>
                  <p class="tool-group-summary">{group.summary}</p>
                </div>

                {group.tools.map((tool) => (
                  <div class="tool-row">
                    <div class="tool-row-name">
                      <code>{tool.name}</code>
                      {tool.access === "write" && (
                        <span class="access-badge access-badge--write">write</span>
                      )}
                      {tool.access === "admin" && (
                        <span class="access-badge access-badge--admin">admin</span>
                      )}
                    </div>
                    <span class="tool-row-desc">{tool.description}</span>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
