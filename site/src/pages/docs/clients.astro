---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import DocsNav from "../../components/DocsNav.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { docsNav } from "../../data/docs-nav";

const DSN = "postgres://dev@localhost:5432/appdb";

const cursorJson = `{
  "mcpServers": {
    "nexql-mcp": {
      "command": "nexql-mcp",
      "args": ["${DSN}"]
    }
  }
}`;

const vscodeJson = `{
  "servers": {
    "nexql-mcp": {
      "type": "stdio",
      "command": "nexql-mcp",
      "args": ["${DSN}"]
    }
  }
}`;

const claudeJson = `{
  "mcpServers": {
    "nexql-mcp": {
      "command": "nexql-mcp",
      "args": ["--tools", "query", "${DSN}"]
    }
  }
}`;
---

<BaseLayout
  title="Client setup — NexQL MCP"
  description="Wire nexql-mcp into Claude, Cursor, VS Code, Zed and Windsurf — with one init command, or by hand."
  canonical="https://nexql-mcp.astrx.dev/docs/clients"
>
  <main id="main" class="mcp-main">
    <PageHeader
      kicker="Reference"
      title="Let init write it,"
      titleEm="or write it yourself."
      lede="Every MCP client wants the same three things — a command, its arguments, and stdio. Only the filename and the wrapper key differ."
    />

    <Section>
      <div class="docs-layout">
        <DocsNav items={docsNav} />

        <div>
          <div class="mcp-prose">
            <h3>The easy way</h3>
            <p>
              <code>init</code> detects the client's config file, merges the server in rather than
              overwriting, and backs up what was there before.
            </p>
          </div>

          <CodeBlock
            copyLabel="command"
            code={`nexql-mcp init cursor ${DSN}

# or pick from a list
nexql-mcp init`}
          />

          <div class="mcp-prose">
            <h3>Cursor</h3>
            <p>
              <code>.cursor/mcp.json</code> in the project, or <code>~/.cursor/mcp.json</code> globally.
            </p>
          </div>
          <CodeBlock label=".cursor/mcp.json" copyLabel="config" code={cursorJson} />

          <div class="mcp-prose">
            <h3>VS Code</h3>
            <p>
              <code>.vscode/mcp.json</code>. Note the key is <code>servers</code>, not
              <code>mcpServers</code>, and the type must be declared.
            </p>
          </div>
          <CodeBlock label=".vscode/mcp.json" copyLabel="config" code={vscodeJson} />

          <div class="mcp-prose">
            <h3>Claude Desktop and Claude Code</h3>
            <p>
              Same shape as Cursor. This example also trims the tool surface with
              <code>--tools query</code>, which is worth doing when the context budget is tight.
            </p>
          </div>
          <CodeBlock label="claude_desktop_config.json" copyLabel="config" code={claudeJson} />

          <div class="mcp-prose">
            <h3>Zed, Windsurf and the rest</h3>
            <p>
              <code>init</code> knows about sixteen clients including Zed, Windsurf, Continue,
              JetBrains and the OpenAI Agents SDK. The full list is on the
              <a class="nx-inline-link" href="/docs/commands">CLI reference</a>.
            </p>
          </div>

          <p class="mcp-note">
            <strong>Not seeing the tools?</strong> Run <code>nexql-mcp {DSN} doctor</code> first. It
            checks the connection, permissions and index state independently of any client, which
            narrows the problem down fast.
          </p>
        </div>
      </div>
    </Section>
  </main>
</BaseLayout>
