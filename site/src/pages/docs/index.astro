---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import { FACTS } from "../../data/site";

const cards = [
  {
    href: "/docs/configuration",
    title: "Configuration",
    body: "Profiles in config.toml — connection details, access mode, schema allowlists, denied tables, PII masking and row caps.",
  },
  {
    href: "/docs/tools",
    title: "Tool reference",
    body: `All ${FACTS.toolCount} tools grouped by category, each with the access mode it needs.`,
  },
  {
    href: "/docs/commands",
    title: "CLI commands",
    body: "Every subcommand and flag, with the NEXQL_MCP_* environment variable that matches it.",
  },
  {
    href: "/docs/clients",
    title: "Client setup",
    body: "Config blocks for Claude, Cursor, VS Code, Zed and Windsurf — or one init command that writes them for you.",
  },
  {
    href: "/docs/transport",
    title: "Transport",
    body: "Stdio for desktop clients, streamable HTTP for everything else, and the auth rules that go with it.",
  },
  {
    href: "/kb",
    title: "Knowledge base",
    body: "Short answers to the questions that come up after you are running.",
  },
];
---

<BaseLayout
  title="Documentation — NexQL MCP"
  description={`Reference documentation for nexql-mcp: configuration, all ${FACTS.toolCount} tools, CLI commands, client setup and transport.`}
  canonical="https://nexql-mcp.astrx.dev/docs"
>
  <main id="main" class="mcp-main">
    <PageHeader
      kicker="Documentation"
      title="Everything the binary does,"
      titleEm="written down."
      lede="Reference material, not a tutorial. If you are setting up for the first time, start at the install page instead."
    />

    <Section>
      <div class="nx-feature-grid">
        {
          cards.map((c) => (
            <a class="nx-feature-card" href={c.href}>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </a>
          ))
        }
      </div>
    </Section>
  </main>
</BaseLayout>
