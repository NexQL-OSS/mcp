---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import { features } from "../../data/features";
import { FACTS } from "../../data/site";
---

<BaseLayout
  title="Features — NexQL MCP"
  description="Schema index, bounded query tools, production diagnostics, the read-only safety model, connection profiles, HTTP transport, and the VS Code integration."
>
  <main id="main" class="mcp-main">
    <PageHeader
      kicker="Capabilities"
      title="Eight things it does"
      titleEm="that a query pipe doesn't."
      lede={`Generic Postgres MCP servers return rows. NexQL MCP grounds the agent in what your database actually contains first — then keeps a hard boundary around what it can change. ${FACTS.toolCount} tools, read-only by default.`}
    />

    <Section>
      <div class="nx-feature-grid">
        {
          features.map((f, i) => (
            <a class="nx-feature-card" href={`/features/${f.slug}`}>
              <div class="nx-feature-mark">{String(i + 1).padStart(2, "0")}</div>
              <h3>
                {f.title} {f.titleEm}
              </h3>
              <p>{f.description}</p>
              <ul>
                {f.bullets.slice(0, 3).map((b) => (
                  <li>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </a>
          ))
        }
      </div>
    </Section>
  </main>
</BaseLayout>
