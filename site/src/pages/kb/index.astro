---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import { KbSearch } from "../../islands/KbSearch";
import { kbArticles } from "../../data/kb";
---

<BaseLayout
  title="Knowledge base — NexQL MCP"
  description="Searchable answers on setup, security, agent workflows, performance and licensing for NexQL MCP."
  canonical="https://nexql-mcp.astrx.dev/kb"
>
  <main id="main" class="mcp-main">
    <PageHeader
      kicker="Knowledge base"
      title={`${kbArticles.length} answers to`}
      titleEm="the second question."
      lede="The docs cover what each flag does. These cover what goes wrong, why a default is the way it is, and which of two options you actually want."
    />

    <Section>
      <KbSearch client:load />
    </Section>
  </main>
</BaseLayout>
