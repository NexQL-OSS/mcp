---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { SITE_VERSION, FACTS } from "../data/site";

const DSN = "postgres://dev@localhost:5432/appdb";
---

<BaseLayout
  title="Install NexQL MCP"
  description="Install nexql-mcp with curl, npm, cargo or Docker, verify it with doctor, and wire it into your MCP client in one command."
  canonical="https://nexql-mcp.astrx.dev/install"
>
  <main id="main" class="mcp-main">
    <PageHeader
      kicker="Installation"
      title="One binary."
      titleEm="No runtime to install."
      lede={`Every path below ships the same static executable and the same guardrails. Pick whichever fits your machine — then run doctor to prove it works before you wire up a client.`}
    />

    <Section
      kicker="Recommended"
      title="Install the binary."
      lede="Drops nexql-mcp into /usr/local/bin, or ~/.local/bin when that is not writable."
      small
    >
      <CodeBlock
        label="macOS / Linux"
        copyLabel="command"
        code="curl -fsSL https://raw.githubusercontent.com/NexQL-OSS/mcp/main/scripts/install.sh | bash"
      />
      <CodeBlock
        label="Windows (PowerShell)"
        copyLabel="command"
        code="irm https://raw.githubusercontent.com/NexQL-OSS/mcp/main/scripts/install.ps1 | iex"
      />
      <p class="mcp-note">
        <strong>Linux needs glibc 2.35 or newer.</strong> On anything older, use the Docker image or
        build from source with cargo.
      </p>
    </Section>

    <Section title="Other channels." small>
      <div class="mcp-prose">
        <h3>npm</h3>
        <p>No install step if you just want to try it — <code>npx</code> fetches and runs it.</p>
      </div>
      <CodeBlock
        copyLabel="commands"
        code={`npx -y nexql-mcp ${DSN}
npm install -g nexql-mcp`}
      />

      <div class="mcp-prose">
        <h3>cargo</h3>
        <p>
          Builds from source. Needs clang and libclang available, because <code>pg_query</code> generates
          its bindings at build time.
        </p>
      </div>
      <CodeBlock copyLabel="command" code="cargo install nexql-mcp" />

      <div class="mcp-prose">
        <h3>Docker</h3>
        <p>
          Note <code>-i</code>: the server speaks MCP over stdio, so the container needs stdin held open.
          From inside a container, <code>localhost</code> is the container — use
          <code>host.docker.internal</code> to reach a database on the host.
        </p>
      </div>
      <CodeBlock
        copyLabel="command"
        code={`docker run --rm -i ghcr.io/nexql-oss/mcp:${SITE_VERSION} \\
  postgres://dev@host.docker.internal:5432/appdb`}
      />

      <div class="mcp-prose">
        <h3>Claude Desktop</h3>
        <p>
          Download the MCPB bundle from the releases page and open it — Claude Desktop installs and
          registers the server for you, no terminal involved.
        </p>
      </div>
    </Section>

    <Section
      kicker="Verify"
      title="Prove it works before wiring anything."
      lede="doctor resolves the connection, checks permissions, and reports the index state. If it passes, your client will work too."
      small
    >
      <CodeBlock label="Check the connection" copyLabel="command" code={`nexql-mcp ${DSN} doctor`} />
      <CodeBlock
        label="Build the schema index"
        copyLabel="command"
        code={`nexql-mcp ${DSN} index build`}
      />
      <p class="mcp-note">
        The index is what makes <code>search_schema</code> and <code>get_join_path</code> fast. Skip this
        and the first call pays for the build.
      </p>
    </Section>

    <Section
      kicker="Wire it up"
      title="One command per client."
      lede="init writes the correct config file for the client you name — or opens a TUI wizard if you name none."
      small
    >
      <CodeBlock
        copyLabel="commands"
        code={`nexql-mcp init claude ${DSN}
nexql-mcp init cursor ${DSN}
nexql-mcp init vscode ${DSN}
nexql-mcp init zed ${DSN}

# no argument opens the interactive wizard
nexql-mcp init`}
      />
      <p class="mcp-note">
        Prefer to write the JSON yourself? Every client's config block is on the
        <a class="nx-inline-link" href="/docs/clients">client setup page</a>.
      </p>
    </Section>

    <Section title="Defaults you get." small>
      <div class="ref-table-wrap">
        <table class="ref-table">
          <thead>
            <tr>
              <th>Setting</th>
              <th>Default</th>
              <th>Change it with</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Access mode</td>
              <td>read</td>
              <td><code>--access-mode write|admin</code></td>
            </tr>
            <tr>
              <td>Transport</td>
              <td>stdio</td>
              <td><code>--http</code></td>
            </tr>
            <tr>
              <td>Tool surface</td>
              <td>full ({FACTS.toolCount} tools)</td>
              <td><code>--tools query|dba|meta</code></td>
            </tr>
            <tr>
              <td>Embeddings</td>
              <td>off</td>
              <td><code>--embeddings local</code></td>
            </tr>
            <tr>
              <td>HTTP port</td>
              <td>{FACTS.httpPort}</td>
              <td><code>--http-port</code></td>
            </tr>
            <tr>
              <td>HTTP bind</td>
              <td>{FACTS.httpBind}</td>
              <td><code>--bind</code></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mcp-note">
        Every flag has a <code>NEXQL_MCP_&lt;UPPER_SNAKE&gt;</code> environment equivalent. Full list on the
        <a class="nx-inline-link" href="/docs/commands">CLI reference</a>.
      </p>
    </Section>
  </main>
</BaseLayout>
