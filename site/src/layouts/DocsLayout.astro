---
/**
 * Docs shell: sidebar "map" (guides + every tool grouped by line) beside the
 * page. Used by the .astro docs pages and, through `layout:` frontmatter, by
 * the Markdown guides, which pass their fields as `frontmatter`.
 */
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { GUIDES, LINES, TOOLS, toolHref } from "../data/docs";
import { REPO_URL } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Short label above the title. */
  eyebrow?: string;
  frontmatter?: { title: string; description: string; eyebrow?: string; slug?: string };
}

const fm = Astro.props.frontmatter;
const title = fm?.title ?? Astro.props.title ?? "Docs";
const description = fm?.description ?? Astro.props.description ?? "";
const eyebrow = fm?.eyebrow ?? Astro.props.eyebrow;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentTool = TOOLS.find((t) => toolHref(t.name) === path);
const isGuide = Boolean(fm);
const editUrl = fm?.slug ? `${REPO_URL}/edit/main/site/src/pages/docs/${fm.slug}.md` : undefined;
---

<BaseLayout title={`${title} · NexQL MCP docs`} description={description}>
  <SiteHeader current="docs" />
  <div class="wrap docs">
    <aside class="side" aria-label="Docs">
      <details class="menu" open>
        <summary class="menu-toggle">
          <span>Docs menu</span>
          <span class="here">{title}</span>
        </summary>
        <nav class="map">
          <a class:list={["map-top", { on: path === "/docs" }]} href="/docs" aria-current={path === "/docs" ? "page" : undefined}>Overview</a>
          <a class:list={["map-top", { on: path === "/docs/tools" }]} href="/docs/tools" aria-current={path === "/docs/tools" ? "page" : undefined}>All {TOOLS.length} tools</a>

          <p class="map-h">Guides</p>
          <ul class="guides">
            {
              GUIDES.map((g) => (
                <li>
                  <a class:list={{ on: path === `/docs/${g.slug}` }} href={`/docs/${g.slug}`} aria-current={path === `/docs/${g.slug}` ? "page" : undefined}>
                    {g.title}
                  </a>
                </li>
              ))
            }
          </ul>

          <p class="map-h">Tools by line</p>
          {
            LINES.map((line) => (
              <details class="line" style={`--c:${line.color}`} open={currentTool?.line.id === line.id}>
                <summary>
                  <span class="dot" aria-hidden="true" />
                  {line.name}
                  <span class="n">{Object.keys(line.tools).length}</span>
                </summary>
                <ul class="stations">
                  {Object.keys(line.tools).map((name) => (
                    <li>
                      <a class:list={{ on: currentTool?.name === name }} href={toolHref(name)} aria-current={currentTool?.name === name ? "page" : undefined}>
                        {name}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }
        </nav>
      </details>
    </aside>

    <main class="doc" id="main" tabindex="-1">
      {
        isGuide ? (
          <article class="prose">
            <p class="eyebrow">{eyebrow ?? "Guide"}</p>
            <h1>{title}</h1>
            {description && <p class="lede">{description}</p>}
            <slot />
            {editUrl && (
              <p class="edit">
                <a href={editUrl}>Suggest a change to this page</a>
              </p>
            )}
          </article>
        ) : (
          <slot />
        )
      }
    </main>
  </div>
  <SiteFooter />
</BaseLayout>

<script>
  // Copy buttons on Markdown code blocks; .astro pages use <Code>.
  for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
    const box = document.createElement("div");
    box.className = "pre-box";
    pre.replaceWith(box);
    box.append(pre);
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy";
    btn.textContent = "Copy";
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.trimEnd());
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Select and copy";
      }
      setTimeout(() => (btn.textContent = "Copy"), 1600);
    });
    box.append(btn);
  }

  // The menu is a disclosure on phones and always open on wider screens.
  const menu = document.querySelector<HTMLDetailsElement>(".menu");
  const wide = matchMedia("(min-width: 960px)");
  const sync = () => menu && (menu.open = wide.matches);
  sync();
  wide.addEventListener("change", sync);
  // Bring the current page's link into view inside the sidebar only.
  const side = document.querySelector<HTMLElement>(".side");
  const on = document.querySelector<HTMLElement>(".map .on");
  if (side && on && wide.matches) side.scrollTop = on.offsetTop - side.clientHeight / 2;
</script>

<style>
  .docs {
    display: grid;
    gap: 32px;
    padding-top: 28px;
  }
  @media (min-width: 960px) {
    .docs {
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 56px;
      padding-top: 40px;
    }
  }

  /* Sidebar */
  .side {
    min-width: 0;
  }
  @media (min-width: 960px) {
    .side {
      position: sticky;
      top: calc(var(--header-h) + 24px);
      align-self: start;
      max-height: calc(100vh - var(--header-h) - 48px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-right: 8px;
      scrollbar-width: thin;
    }
  }
  .menu {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }
  @media (min-width: 960px) {
    .menu {
      border: 0;
      background: none;
    }
  }
  .menu-toggle {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  .menu-toggle::-webkit-details-marker {
    display: none;
  }
  @media (min-width: 960px) {
    .menu-toggle {
      display: none;
    }
  }
  .menu-toggle .here {
    color: var(--muted);
    font-weight: 400;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .map {
    padding: 4px 14px 16px;
    font-size: 14.5px;
  }
  @media (min-width: 960px) {
    .map {
      padding: 0;
    }
  }
  .map a {
    color: var(--muted);
    display: block;
    padding: 4px 8px;
    border-radius: 6px;
  }
  .map a:hover {
    color: var(--fg);
    text-decoration: none;
    background: var(--panel-2);
  }
  .map a.on {
    color: var(--fg);
    background: var(--panel-2);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .map-top {
    font-weight: 600;
  }
  .map-h {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 22px 8px 8px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .line summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    cursor: pointer;
    color: var(--fg);
    font-weight: 500;
    border-radius: 6px;
    list-style: none;
  }
  .line summary::-webkit-details-marker {
    display: none;
  }
  .line summary:hover {
    background: var(--panel-2);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--c);
    flex: none;
  }
  .line[open] .dot {
    background: var(--c);
  }
  .n {
    margin-left: auto;
    font: 500 11px/1 var(--font-mono);
    color: var(--faint);
  }
  /* A coloured track down the open line, with a stop per tool. */
  .stations {
    margin: 2px 0 8px 12px;
    border-left: 2px solid var(--c);
    padding-left: 4px;
  }
  .stations a {
    font: 400 12.5px/1.5 var(--font-mono);
    position: relative;
    padding-left: 14px;
  }
  .stations a::before {
    content: "";
    position: absolute;
    left: -11px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--c);
  }
  .stations a.on::before {
    background: var(--c);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 30%, transparent);
  }
  .stations a.on {
    box-shadow: none;
  }

  .doc {
    min-width: 0;
    padding-bottom: 24px;
  }
  .edit {
    margin-top: 48px;
    font-size: 14px;
  }
</style>

<style is:global>
  /* Shared docs typography: Markdown guides and the .astro docs pages. */
  .eyebrow {
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .doc h1 {
    font-size: clamp(32px, 5vw, 46px);
    font-weight: 700;
  }
  .lede {
    color: var(--muted);
    font-size: 18.5px;
    margin-top: 14px;
    max-width: 68ch;
  }
  .prose {
    max-width: 76ch;
  }
  .prose > * + * {
    margin-top: 16px;
  }
  .prose h2 {
    font-size: 26px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .prose h3 {
    font-size: 19px;
    margin-top: 32px;
  }
  .prose p,
  .prose li {
    color: var(--prose);
  }
  .prose ul,
  .prose ol {
    padding-left: 22px;
  }
  .prose li + li {
    margin-top: 6px;
  }
  .prose strong {
    color: var(--fg);
  }
  .prose blockquote {
    margin: 20px 0 0;
    padding: 12px 16px;
    border: 1px solid color-mix(in srgb, var(--warn) 40%, transparent);
    background: color-mix(in srgb, var(--warn) 7%, transparent);
    border-radius: 10px;
  }
  .prose blockquote p {
    color: var(--fg);
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
    display: block;
    overflow-x: auto;
  }
  .prose th,
  .prose td {
    text-align: left;
    padding: 9px 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .prose th {
    font: 500 11.5px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .pre-box {
    position: relative;
  }
  .prose pre {
    margin: 0;
    padding: 16px 18px;
    padding-right: 76px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-deep) !important;
    overflow-x: auto;
    font-size: 13.5px;
    line-height: 1.65;
  }
  .pre-box .copy {
    position: absolute;
    top: 9px;
    right: 9px;
  }
  .prose a code {
    color: var(--accent);
  }
</style>
